//@version=6
indicator(title = "MACD Indicator", shorttitle = "MACD", overlay = false)

// ─── INPUTS ───────────────────────────────────────────────────────────────────
fastLength   = input.int(12,    title = "Fast Length",   minval = 1)
slowLength   = input.int(26,    title = "Slow Length",   minval = 1)
signalLength = input.int(9,     title = "Signal Length", minval = 1)
srcInput     = input.source(close, title = "Source")

// ─── MACD CALCULATION ─────────────────────────────────────────────────────────
fastMA   = ta.ema(srcInput, fastLength)
slowMA   = ta.ema(srcInput, slowLength)
macdLine = fastMA - slowMA
signalLine = ta.ema(macdLine, signalLength)
histogram  = macdLine - signalLine

// ─── COLORS ───────────────────────────────────────────────────────────────────
histColorBullStrong = input.color(color.new(#26a69a, 0),  title = "Histogram Bull (Growing)",   group = "Colors")
histColorBullWeak   = input.color(color.new(#26a69a, 50), title = "Histogram Bull (Declining)", group = "Colors")
histColorBearStrong = input.color(color.new(#ef5350, 0),  title = "Histogram Bear (Growing)",   group = "Colors")
histColorBearWeak   = input.color(color.new(#ef5350, 50), title = "Histogram Bear (Declining)", group = "Colors")

histColor = histogram >= 0
     ? (histogram > histogram[1] ? histColorBullStrong : histColorBullWeak)
     : (histogram < histogram[1] ? histColorBearStrong : histColorBearWeak)

// ─── SIGNALS ──────────────────────────────────────────────────────────────────
bullCross = ta.crossover(macdLine,  signalLine)
bearCross = ta.crossunder(macdLine, signalLine)

bullAboveZero = bullCross and macdLine > 0
bearBelowZero = bearCross and macdLine < 0
bullBelowZero = bullCross and macdLine < 0
bearAboveZero = bearCross and macdLine > 0

// ─── PLOTS ────────────────────────────────────────────────────────────────────
plot(histogram,  title = "Histogram",    style = plot.style_columns, color = histColor)
plot(macdLine,   title = "MACD Line",    color = color.new(#2962ff, 0), linewidth = 2)
plot(signalLine, title = "Signal Line",  color = color.new(#ff6d00, 0), linewidth = 2)
hline(0, title = "Zero Line", color = color.new(color.gray, 50), linestyle = hline.style_dashed)

// ─── SIGNAL LABELS ────────────────────────────────────────────────────────────
plotshape(bullAboveZero, title = "Bull Cross Above Zero", location = location.bottom,
     style = shape.triangleup,   color = color.new(#26a69a, 0),  size = size.small, text = "BUY")
plotshape(bearBelowZero, title = "Bear Cross Below Zero", location = location.top,
     style = shape.triangledown, color = color.new(#ef5350, 0),  size = size.small, text = "SELL")
plotshape(bullBelowZero, title = "Bull Cross Below Zero", location = location.bottom,
     style = shape.triangleup,   color = color.new(#26a69a, 50), size = size.tiny,  text = "WEAK BUY")
plotshape(bearAboveZero, title = "Bear Cross Above Zero", location = location.top,
     style = shape.triangledown, color = color.new(#ef5350, 50), size = size.tiny,  text = "WEAK SELL")

// ─── ALERTS ───────────────────────────────────────────────────────────────────
alertcondition(bullCross,      title = "MACD Bull Cross",            message = "MACD: Bullish crossover — MACD crossed above Signal")
alertcondition(bearCross,      title = "MACD Bear Cross",            message = "MACD: Bearish crossover — MACD crossed below Signal")
alertcondition(bullAboveZero,  title = "MACD Bull Cross Above Zero", message = "MACD: Strong BUY signal — Bull cross above zero line")
alertcondition(bearBelowZero,  title = "MACD Bear Cross Below Zero", message = "MACD: Strong SELL signal — Bear cross below zero line")
alertcondition(ta.crossover(macdLine,  0), title = "MACD Cross Above Zero", message = "MACD Line crossed above zero")
alertcondition(ta.crossunder(macdLine, 0), title = "MACD Cross Below Zero", message = "MACD Line crossed below zero")

// ─── INFO TABLE ───────────────────────────────────────────────────────────────
showTable = input.bool(true, title = "Show Info Table", group = "Display")

if showTable
    var table infoTable = table.new(position.top_right, 2, 5,
         bgcolor = color.new(color.black, 80), border_width = 1, border_color = color.new(color.gray, 50))

    macdTrend = macdLine > 0 ? "BULLISH" : "BEARISH"
    macdColor = macdLine > 0 ? color.new(#26a69a, 0) : color.new(#ef5350, 0)
    histTrend = histogram > histogram[1] ? "GROWING" : "DECLINING"

    table.cell(infoTable, 0, 0, "MACD",         text_color = color.white,  text_size = size.small, bgcolor = color.new(color.gray, 70))
    table.cell(infoTable, 1, 0, str.tostring(math.round(macdLine, 4)),   text_color = macdColor, text_size = size.small)
    table.cell(infoTable, 0, 1, "Signal",        text_color = color.white,  text_size = size.small, bgcolor = color.new(color.gray, 70))
    table.cell(infoTable, 1, 1, str.tostring(math.round(signalLine, 4)), text_color = color.new(#ff6d00, 0), text_size = size.small)
    table.cell(infoTable, 0, 2, "Histogram",     text_color = color.white,  text_size = size.small, bgcolor = color.new(color.gray, 70))
    table.cell(infoTable, 1, 2, str.tostring(math.round(histogram, 4)),  text_color = histColor, text_size = size.small)
    table.cell(infoTable, 0, 3, "Trend",         text_color = color.white,  text_size = size.small, bgcolor = color.new(color.gray, 70))
    table.cell(infoTable, 1, 3, macdTrend,       text_color = macdColor,    text_size = size.small)
    table.cell(infoTable, 0, 4, "Histogram",     text_color = color.white,  text_size = size.small, bgcolor = color.new(color.gray, 70))
    table.cell(infoTable, 1, 4, histTrend,       text_color = histColor,    text_size = size.small)
